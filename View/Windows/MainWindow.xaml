                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

    </Window.Resources>


    <Grid >
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <LinearGradientBrush.GradientStops>
                    <GradientStop Color="DarkBlue" Offset="0.0"/>
                    <GradientStop Color="CadetBlue"  Offset="0.3 "/>
                    <GradientStop Color="OrangeRed"  Offset="0.9 "/>
                    <GradientStop Color="HotPink" Offset="1.0"/>
                </LinearGradientBrush.GradientStops>

            </LinearGradientBrush>
        </Grid.Background>
        <Border Background="{StaticResource PinkWaveBackground}">
            <Border.Effect>
                <BlurEffect Radius="20"/>
            </Border.Effect>
        </Border>
        <Grid>
            

            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="450"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition MinWidth="960"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            

            <!--Контейнер с интерактивными элементами-->
            <Grid Grid.Row="1" Grid.Column="1" Panel.ZIndex="2">
                <Grid Grid.Column="1" Panel.ZIndex="2" Background="White">

                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition MinWidth="480"/>
                            <ColumnDefinition MinWidth="480"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Grid.Row="0" HorizontalAlignment="Right">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition MinWidth="240"/>
                                <ColumnDefinition MinWidth="240"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,15,15,0" Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Right"  VerticalAlignment="Center">
                                <CheckBox Content="Строчные латинские буквы (z,x,c,...)"/>
                                <CheckBox Content="Заглавные латинские буквы (Z,X,C,...)"/>
                                <CheckBox Content="Спец символы (!,@,#,-)"/>
                            </StackPanel>

                            <StackPanel Margin="15,15,0,0" Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Label Content="Количество символов (1-32):"/>
                                <TextBox Width="100"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15">
                            <Label Content="Способ генерации: "/>
                            <ComboBox Width="200">
                                <ComboBoxItem>Звуковая карта</ComboBoxItem>
                                <ComboBoxItem>Движение мыши</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                    </Grid>

                    <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBox FontSize="16" TextAlignment="Center"  Width="400" Text="123" IsReadOnly="True" />
                        <Button FontSize="16" ToolTip="Копировать">
                            <fa:FontAwesome Icon="Copy" Margin="2"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Content="Сгенерировать" FontSize="16" Padding="3">
                        </Button>
                    </StackPanel>





                </Grid>
            </Grid>
        </Grid>
    </Grid>
    
    




</Window>
