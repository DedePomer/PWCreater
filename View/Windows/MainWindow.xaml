<Window x:Class="PWCreater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PWCreater"
        
         xmlns:vm="clr-namespace:PWCreater.ViewModel.Windows"
         xmlns:fa="http://schemas.fontawesome.io/icons/"
        
        mc:Ignorable="d"          
        Title="MainWindow" Height="800" MinHeight="450" Width="1000" MinWidth="1000">

    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <RadialGradientBrush x:Key="Wave1Gradient">
            <RadialGradientBrush.RelativeTransform>
                <!-- Сдвигаем центр градиента наверх -->
                <TranslateTransform Y="-0.5"/>
            </RadialGradientBrush.RelativeTransform>
            <GradientStop Color="Purple" Offset="0" />
            <GradientStop Color="Transparent" Offset="1" />
        </RadialGradientBrush>

        <!-- Радиационный градиент для второй волны, с поднятым фокусом -->
        <RadialGradientBrush x:Key="Wave2Gradient">
            <RadialGradientBrush.RelativeTransform>
                <!-- Сдвигаем центр градиента наверх -->
                <TranslateTransform Y="-0.5"/>
            </RadialGradientBrush.RelativeTransform>
            <GradientStop Color="Orange" Offset="0" />
            <GradientStop Color="Transparent" Offset="1" />
        </RadialGradientBrush>



    </Window.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="450"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <LinearGradientBrush.GradientStops>
                        <GradientStop Color="DarkBlue" Offset="0.0"/>
                        <GradientStop Color="CadetBlue"  Offset="0.3 "/>
                        <GradientStop Color="DarkSeaGreen"  Offset="0.4 "/>
                        <GradientStop Color="YellowGreen"  Offset="0.6 "/>
                        <GradientStop Color="OrangeRed"  Offset="0.9 "/>
                        <GradientStop Color="HotPink" Offset="1.0"/>
                    </LinearGradientBrush.GradientStops>

                </LinearGradientBrush>
            </Grid.Background>
            <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Border.Effect>
                    <BlurEffect Radius="50"/>
                </Border.Effect>
                <Canvas ClipToBounds="True">

                    <!--<Path Stroke="Pink" Fill="{StaticResource Wave1Gradient}" StrokeThickness="20" Data="M 53.163668,5.015058 A 14.738297,8.3696166 0 0 1 66.411418,0.31320367 14.738297,8.3696166 0 0 1 79.66542,5.0223424 M 26.681786,5.0045762 A 14.738297,8.3696166 0 0 0 39.92954,9.706429 14.738297,8.3696166 0 0 0 53.183536,4.9972927 M 0.18990161,5.0151734 A 14.738297,8.3696166 0 0 1 13.437657,0.31332082 14.738297,8.3696166 0 0 1 26.691655,5.022457" Height="54" Stretch="Fill" Width="376" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Path.Effect>
                            <BlurEffect Radius="30"/>
                            --><!--<DropShadowEffect ShadowDepth="1" BlurRadius="8"/>--><!--
                        </Path.Effect>
                    </Path>-->


                </Canvas>

            </Border>
            


        </Grid>


        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="1000"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!--Контейнер с интерактивными элементами-->
            <Grid Grid.Column="1" >

                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition MinWidth="480"/>
                        <ColumnDefinition MinWidth="480"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" HorizontalAlignment="Right">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition MinWidth="240"/>
                            <ColumnDefinition MinWidth="240"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,15,15,0" Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Right"  VerticalAlignment="Center">
                            <CheckBox Content="Строчные латинские буквы (z,x,c,...)"/>
                            <CheckBox Content="Заглавные латинские буквы (Z,X,C,...)"/>
                            <CheckBox Content="Спец символы (!,@,#,-)"/>
                        </StackPanel>

                        <StackPanel Margin="15,15,0,0" Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Label Content="Количество символов (1-32):"/>
                            <TextBox Width="100"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15">
                        <Label Content="Способ генерации: "/>
                        <ComboBox Width="200">
                            <ComboBoxItem>Звуковая карта</ComboBoxItem>
                            <ComboBoxItem>Движение мыши</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                </Grid>

                <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBox FontSize="16" TextAlignment="Center"  Width="400" Text="123" IsReadOnly="True" />
                    <Button FontSize="16" ToolTip="Копировать">
                        <fa:FontAwesome Icon="Copy" Margin="2"/>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="Сгенерировать" FontSize="16" Padding="3">
                    </Button>
                </StackPanel>

            </Grid>


        </Grid>



    </Grid>



</Window>
