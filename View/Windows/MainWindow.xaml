<Window x:Class="PWCreater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PWCreater"
        
        xmlns:vm="clr-namespace:PWCreater.ViewModel.Windows"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        xmlns:ut="clr-namespace:PWCreater.Model.UserType"
        
        mc:Ignorable="d"          
        Title="MainWindow" 
        Height="450"  Width="960" 
        MinWidth="960" MinHeight="450">

    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <ResourceDictionary Source="/Data/ResourceDictionary/NormalDictionary.xaml"/>
        
    </Window.Resources>


    <Grid Background="{StaticResource NormalBackground}">

        <Border Background="{StaticResource PinkWaveBackground}">
            <Border.Effect>
                <BlurEffect Radius="20"/>
            </Border.Effect>
        </Border>
        <Grid>
            
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="450"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition MinWidth="960"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            

            <!--Контейнер с интерактивными элементами-->
            <Grid Grid.Row="1" Grid.Column="1" Panel.ZIndex="2">
                <Grid Grid.Column="1" Panel.ZIndex="2" Background="White">

                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition MinWidth="480"/>
                            <ColumnDefinition MinWidth="480"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Grid.Row="0" HorizontalAlignment="Right">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition MinWidth="240"/>
                                <ColumnDefinition MinWidth="240"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel DataContext="{Binding Path = Alphabet}"  Margin="0,15,15,0" Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Right"  VerticalAlignment="Center">
                                <CheckBox  IsChecked="{Binding LowerLatinLetters}" Content="Строчные латинские буквы (z,x,c,...)"/>
                                <!--<CheckBox IsChecked="{Binding AddUpperLatinLetters}" Content="Заглавные латинские буквы (Z,X,C,...)"/>
                                <CheckBox IsChecked="{Binding AddSpecialSymbols}" Content="Спец символы (!,@,#,-)"/>-->
                            </StackPanel>

                            <StackPanel Margin="15,15,0,0" Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Label Content="Количество символов (1-32):"/>
                                <TextBox Text="{Binding CountSymbolsInPasswords, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15">
                            <Label Content="Способ генерации: "/>
                            <ComboBox SelectedIndex="{Binding SelectedGenerationMethod}" Width="200">
                                <ComboBoxItem >Звуковая карта</ComboBoxItem>
                                <ComboBoxItem>Движение мыши</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                    </Grid>

                    <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBox FontSize="16" TextAlignment="Center"  Width="400" Text="{Binding PasswordString}" IsReadOnly="True" />
                        <Button FontSize="16" ToolTip="Копировать" Command="{Binding CopyPasswordCommand}">
                            <fa:FontAwesome Icon="Copy" Margin="2"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Content="Сгенерировать" FontSize="16" Padding="3" Command="{Binding GeneratePasswordCommand}">
                        </Button>
                    </StackPanel>

                </Grid>
            </Grid>
        </Grid>
    </Grid>
    
    




</Window>
