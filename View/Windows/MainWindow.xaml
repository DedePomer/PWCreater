<Window x:Class="PWCreater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PWCreater"
        
         xmlns:vm="clr-namespace:PWCreater.ViewModel.Windows"
         xmlns:fa="http://schemas.fontawesome.io/icons/"
        
        mc:Ignorable="d"          
        Title="MainWindow" Height="800" MinHeight="450" Width="1600" MinWidth="1000">

    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <RadialGradientBrush x:Key="Wave1Gradient">
            <GradientStop Color="CadetBlue" />
        </RadialGradientBrush>

        <RadialGradientBrush x:Key="Wave2Gradient">
            <GradientStop Color="Orange"  />
        </RadialGradientBrush>


        <RadialGradientBrush x:Key="Wave3Gradient">
            <GradientStop Color="GreenYellow"  />
        </RadialGradientBrush>

        <RadialGradientBrush x:Key="Wave4Gradient">
            <GradientStop Color="PaleVioletRed"  />
        </RadialGradientBrush>


    </Window.Resources>


    <Grid>
        
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="450"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <LinearGradientBrush.GradientStops>
                    <GradientStop Color="DarkBlue" Offset="0.0"/>
                    <GradientStop Color="CadetBlue"  Offset="0.3 "/>
                    <GradientStop Color="OrangeRed"  Offset="0.9 "/>
                    <GradientStop Color="HotPink" Offset="1.0"/>
                </LinearGradientBrush.GradientStops>

            </LinearGradientBrush>
        </Grid.Background>






        <!--Контейнер с интерактивными элементами-->
        <Grid Grid.Row="1" >

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
        
            <Grid Grid.Column="1">
                <Canvas Panel.ZIndex="2" Background="White">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition MinWidth="480"/>
                            <ColumnDefinition MinWidth="480"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>


                        <Grid Grid.Column="0" Grid.Row="0" HorizontalAlignment="Right">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition MinWidth="240"/>
                                <ColumnDefinition MinWidth="240"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,15,15,0" Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Right"  VerticalAlignment="Center">
                                <CheckBox Content="Строчные латинские буквы (z,x,c,...)"/>
                                <CheckBox Content="Заглавные латинские буквы (Z,X,C,...)"/>
                                <CheckBox Content="Спец символы (!,@,#,-)"/>
                            </StackPanel>

                            <StackPanel Margin="15,15,0,0" Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Label Content="Количество символов (1-32):"/>
                                <TextBox Width="100"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15">
                            <Label Content="Способ генерации: "/>
                            <ComboBox Width="200">
                                <ComboBoxItem>Звуковая карта</ComboBoxItem>
                                <ComboBoxItem>Движение мыши</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                    </Grid>

                    <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBox FontSize="16" TextAlignment="Center"  Width="400" Text="123" IsReadOnly="True" />
                        <Button FontSize="16" ToolTip="Копировать">
                            <fa:FontAwesome Icon="Copy" Margin="2"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Content="Сгенерировать" FontSize="16" Padding="3">
                        </Button>
                    </StackPanel>
            
                </Canvas>
                
        
            
            </Grid>
        </Grid>






    </Grid>



</Window>
