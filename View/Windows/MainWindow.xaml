<Window x:Class="PWCreater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PWCreater"
        
        xmlns:vm="clr-namespace:PWCreater.ViewModel.Windows"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        xmlns:ut="clr-namespace:PWCreater.Model.UserType"
        
        mc:Ignorable="d"          
        Title="MainWindow" 
        Height="450"  Width="960" 
        MinWidth="960" MinHeight="460">

    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <ResourceDictionary Source="/Data/ResourceDictionary/NormalDictionary.xaml"/>
    </Window.Resources>


    <Grid Background="{StaticResource NormalBackground}">

        <Border Background="{StaticResource PinkWaveBackground}">
            <Border.Effect>
                <BlurEffect Radius="20"/>
            </Border.Effect>
        </Border>
        
        <!--данный грид разделяет центральную часть (белую) и внешюю (разноцветную)-->
        <Grid>
            
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="450"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition MinWidth="960"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            

            <!--Контейнер с интерактивными элементами-->
            <Grid Grid.Row="1" Grid.Column="1" Panel.ZIndex="2">
                <Grid Grid.Column="1" Panel.ZIndex="2" Background="White">

                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    
                    <!--блок выбора способа генерации и типа символов-->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Grid  Grid.Row="0" HorizontalAlignment="Left">
                            <StackPanel  Margin="10,0,0,0"  Orientation="Vertical" HorizontalAlignment="Left"  VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding Alphabet.LowerLatinLetters}" Content="Строчные латинские буквы (z,x,c,...)"/>
                                <CheckBox IsChecked="{Binding Alphabet.UpperLatinLetters}" Content="Заглавные латинские буквы (Z,X,C,...)"/>
                                <CheckBox IsChecked="{Binding Alphabet.SpecialSymbols}" Content="Спец символы (!,@,#,-)"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10 0 0 0">
                            <Label Content="Способ генерации: "/>
                            <ComboBox SelectedIndex="{Binding SelectedGenerationMethod}" Width="200">
                                <ComboBoxItem >Звуковая карта</ComboBoxItem>
                                <ComboBoxItem>Движение мыши</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!--блок со слайдером-->
                    <Grid Grid.Row="1">
                        <StackPanel Margin="10 0 0 0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Label Width="30" FontSize="15" Content="{Binding Value, ElementName=CountSymbolsSlider}"/>
                            <Slider x:Name="CountSymbolsSlider" Width="500" Minimum="{Binding MinimumSymbols}" 
                                    Maximum="{Binding MaximumSymbols}" Value="{Binding CountSymbols}" LargeChange="1"
                                    TickFrequency="4" TickPlacement="BottomRight" Foreground="Black">
                            </Slider>
                        </StackPanel>
                    </Grid>
                    <!--блок с сгенерированным паролем и примечаниями-->
                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Label Content="В разработке" FontSize="20" Foreground="Green"/>
                        </StackPanel>
                        
                        
                        <StackPanel Grid.Column="1" Margin="0 0 20 30" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel Margin="10" Orientation="Horizontal">
                                <TextBox FontSize="16" TextAlignment="Center"  Width="400" Text="{Binding PasswordString}" IsReadOnly="True" />
                                <Button FontSize="16" ToolTip="Копировать" Command="{Binding CopyPasswordCommand}">
                                    <fa:FontAwesome Icon="Copy" Margin="2"/>
                                </Button>
                            </StackPanel >


                            <StackPanel Margin="10" HorizontalAlignment="Right">
                                <Button Width="150" Content="Сгенерировать" FontSize="16" Padding="3" Command="{Binding GeneratePasswordCommand}">
                                </Button>
                            </StackPanel>
                        </StackPanel>
                        

                    </Grid>

                </Grid>
            </Grid>
        </Grid>
    </Grid>
    
    




</Window>
